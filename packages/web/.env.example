# 前端测试可覆盖配置（全部可选，均有代码内 fallback，不提交 .env）
# 测试服务绑定地址
OPENSPECUI_TEST_SERVER_HOST=127.0.0.1
# 服务启动等待超时（毫秒）
OPENSPECUI_TEST_STARTUP_TIMEOUT_MS=30000
# 单个耗时用例超时（毫秒）
OPENSPECUI_TEST_CASE_TIMEOUT_MS=30000
# Testing Library 查询等待超时（毫秒）
OPENSPECUI_TEST_FIND_TIMEOUT_MS=10000
# 临时目录名前缀
OPENSPECUI_TEST_TMP_PREFIX=openspecui-web-test-
# 可视化回归视口
OPENSPECUI_TEST_VRT_DESKTOP_WIDTH=1440
OPENSPECUI_TEST_VRT_DESKTOP_HEIGHT=900
OPENSPECUI_TEST_VRT_MOBILE_WIDTH=390
OPENSPECUI_TEST_VRT_MOBILE_HEIGHT=844
# 截图允许失配像素比例
OPENSPECUI_TEST_VRT_MISMATCHED_PIXEL_RATIO=0.01
